        }
      },
      "description": "GetMeResponse contains the profile of the authenticated user."
    },
    "v1Profile": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid",
          "description": "ID of the user the profile belongs to."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user registered."
        }
      },
      "description": "Profile contains profile data for a registered user."
    }
