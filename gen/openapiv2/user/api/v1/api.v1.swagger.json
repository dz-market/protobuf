  ],
  "paths": {
    "/v1/profile": {
      "get": {
        "summary": "Get the caller's profile",
        "operationId": "ProfileService_GetMe",
        "responses": {
          "200": {
            "description": "The caller's profile.",
            "schema": {
              "$ref": ".user.v1.GetMeResponse"
            }
          },
          "401": {
            "description": "Missing, expired or invalid access token.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          },
          "404": {
            "description": "Profile is not created yet.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          },
          "500": {
            "description": "Internal error.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "ProfileService"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1GetMeResponse": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/definitions/v1Profile",
          "description": "The caller's profile."
        }
      },
      "description": "GetMeResponse returns the caller's profile."
    },
    "v1Profile": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid",
          "description": "ID of the user the profile belongs to."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user registered."
        }
      },
      "description": "Profile is the profile for a registered user."
    }
  },
  "securityDefinitions": {
    "bearer": {
      "type": "apiKey",
      "description": "Access token as \"Bearer {token}\".",
      "name": "Authorization",
      "in": "header"
